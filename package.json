{
  "name": "virtual-module-core",
  "version": "0.1.1",
  "description": "Core module system with DI container, module registry, and TypeScript interfaces",
  "type": "module",
  "main": "./sveltekit/dist/index.js",
  "module": "./sveltekit/dist/index.js",
  "types": "./sveltekit/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./sveltekit/dist/index.d.ts",
      "import": "./sveltekit/dist/index.js"
    },
    "./di": {
      "types": "./sveltekit/dist/di/index.d.ts",
      "import": "./sveltekit/dist/di/index.js"
    },
    "./registry": {
      "types": "./sveltekit/dist/registry/index.d.ts",
      "import": "./sveltekit/dist/registry/index.js"
    },
    "./types": {
      "types": "./sveltekit/dist/types/index.d.ts",
      "import": "./sveltekit/dist/types/index.js"
    }
  },
  "scripts": {
    "build": "cd sveltekit && npm run build",
    "dev": "cd sveltekit && npm run dev",
    "clean": "cd sveltekit && npm run clean",
    "prepare": "cd sveltekit && npm run build",
    "test": "cd sveltekit && npm test",
    "lint": "cd sveltekit && npm run lint",
    "audit": "cd sveltekit && npm audit"
  },
  "keywords": [
    "dependency-injection",
    "module-system",
    "virtual-modules",
    "appshell"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reidlai/virtual-module-core.git"
  },
  "author": "Reid Lai",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  }
}