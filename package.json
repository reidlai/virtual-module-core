{
  "name": "virtual-module-core",
  "version": "0.1.1",
  "description": "Core module system with DI container, module registry, and TypeScript interfaces",
  "type": "module",
  "workspaces": [
    "sveltekit"
  ],
  "main": "./sveltekit/src/index.ts",
  "module": "./sveltekit/src/index.ts",
  "types": "./sveltekit/src/index.ts",
  "exports": {
    ".": {
      "types": "./sveltekit/src/index.ts",
      "import": "./sveltekit/src/index.ts"
    },
    "./di": {
      "types": "./sveltekit/src/di/index.ts",
      "import": "./sveltekit/src/di/index.ts"
    },
    "./registry": {
      "types": "./sveltekit/src/registry/index.ts",
      "import": "./sveltekit/src/registry/index.ts"
    },
    "./types": {
      "types": "./sveltekit/src/types/index.ts",
      "import": "./sveltekit/src/types/index.ts"
    }
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "prepare": "npm run build",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "audit": "npm audit --workspaces --if-present"
  },
  "keywords": [
    "dependency-injection",
    "module-system",
    "virtual-modules",
    "appshell"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reidlai/virtual-module-core.git"
  },
  "author": "Reid Lai",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.2",
    "typescript": "^5.3.0",
    "vitest": "^4.0.16"
  }
}